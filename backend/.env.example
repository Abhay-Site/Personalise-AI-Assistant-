# ─────────────────────────────────────────────────────────────
# Personal AI Assistant — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Gemini AI ─────────────────────────────────────────────────
# Get your free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Database ──────────────────────────────────────────────────
# SQLite file path (relative to backend/ directory)
DATABASE_URL=sqlite:///./personal_ai_assistant.db

# ── Server ────────────────────────────────────────────────────
# Secret key used for session signing (use a long random string)
SECRET_KEY=change-me-to-a-long-random-secret-key

# ── Frontend ──────────────────────────────────────────────────
# URL of the Next.js frontend (for CORS)
FRONTEND_URL=http://localhost:3000

# ── Google OAuth ─────────────────────────────────────────────
# Phase 3: Fill these in when adding real Google integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# ── Privacy Shield ────────────────────────────────────────────
# Phase 6: Enable/disable PII redaction before LLM calls
PRIVACY_SHIELD_ENABLED=false
